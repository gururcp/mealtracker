# --- Personal / reference data (never commit) ---
# Physical plan photos and PDFs contain real member health data
*.jpeg
*.jpg
*.pdf
*.png

# UI drafts not yet in sync with schema
ui-design/

# --- User-specific seed migrations (contain PII + PINs) ---
# Any migration that seeds a real member's household or references them by name
# stays local-only. Public schema/food-master migrations are fine to commit.
supabase/migrations/*_seed_*_household.sql
supabase/migrations/*vijaya*.sql

