# =============================================================================
# Meal-Tracker — Environment configuration (LOCAL)
# =============================================================================
# Copy this file to `.env.local` (which is gitignored) and fill in real values.
# Get all three values from Supabase Dashboard → Project → Settings → API.
#
# NEXT_PUBLIC_* variables are sent to the browser. Do NOT put secrets here.
# The service_role key stays server-only (never prefixed with NEXT_PUBLIC_).
# =============================================================================

# Project URL — e.g. https://dnoinuuwkddrdhbpmukx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Anon (public) key — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — SERVER-ONLY. Grants full DB access, bypasses RLS.
# Leaking this = anyone can read/write any table. Never send to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Application secret used to sign the session cookie (any long random string).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_COOKIE_SECRET=
