# =============================================================================
# Meal-Tracker — Environment configuration (LOCAL)
# =============================================================================
# Copy this file to `.env.local` (which is gitignored) and fill in real values.
# Get all three from Supabase Dashboard → Project → Settings → API Keys.
#
# Uses the new (non-legacy) API key format:
#   publishable  → sb_publishable_...   (safe in the browser)
#   secret       → sb_secret_...        (server-only; full access; bypasses RLS)
#
# The old anon / service_role JWT keys still work if you paste them here, but
# new projects should prefer publishable/secret. Rotate the secret if it leaks.
#
# NEXT_PUBLIC_* variables are sent to the browser. Do NOT put secrets there.
# =============================================================================

# Project URL — e.g. https://dnoinuuwkddrdhbpmukx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key — sb_publishable_...  (safe for browser)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key — sb_secret_...  SERVER-ONLY. Full DB access. Bypasses RLS.
# Leaking this = anyone can read/write any table. Rotate immediately if exposed.
SUPABASE_SECRET_KEY=

# Application secret used to sign the session cookie (any long random string).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_COOKIE_SECRET=
